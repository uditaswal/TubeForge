# TubeForge .gitignore — source, migrations, tests, skills, config and docs stay tracked.
# Everything generated at runtime, downloaded, machine-local or secret stays out.

# --- Secrets and credentials (template .env.example stays tracked) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
client_secret*.json
service-account*.json
*token*.json
/.aws/
gitleaks-report*.json

# --- Python environments, caches, build output ---
.venv*/
.deps/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Test and review scratch directories (pytest --basetemp etc.) ---
.tmp/
.test-tmp/
.pytest-*
.safety-*
.review-*
.m*-pytest-*
.m*-focused-tmp*
.m*-full-tmp*
.playwright/
test-results/
playwright-report/

# --- Runtime data: database, jobs, caches, rendered artifacts, models ---
data/
/artifacts/
/models/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
:memory:*
*.sock
*.pid

# --- Logs and agent run state (AUTONOMOUS_PROGRESS.md is a local-only log) ---
*.log
nohup.out
autonomous_logs/
/.codex/
/.codex-overnight/
AUTONOMOUS_PROGRESS.md
AUTONOMOUS_PROGRESS.md_*
OVERNIGHT_MISSION.md
issues.md
/git-repos/
/o/
/src/tubeforge/core/r

# Per-machine Claude Code state; the shared .claude/settings.json stays tracked.
/.claude/*
!/.claude/settings.json

# --- Generated media and model weights anywhere (small fixtures/examples stay trackable) ---
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.m4a
*.onnx
*.onnx.json
*.safetensors
*.gguf
*.pt
*.npz
*.bin
!tests/fixtures/**/*.mp4
!tests/fixtures/**/*.wav
!examples/**/*.mp4
!examples/**/*.wav

# --- Editors and OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
*.bundle
