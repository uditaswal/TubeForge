    target_duration_tolerance_ratio: float = Field(default=0.20, ge=0.01, le=0.50)

class RenderProfile(BaseModel):
    """Bounded deterministic profile for the low-resolution review render."""

    model_config = ConfigDict(extra="forbid")
    width: int = Field(default=854, ge=160, le=3840)
    height: int = Field(default=480, ge=90, le=2160)
    fps: int = Field(default=30, ge=1, le=60)
    fps_tolerance: float = Field(default=0.05, ge=0, le=0.25)
    pixel_format: str = Field(default="yuv420p", pattern=r"^[A-Za-z0-9_]+$")
    video_codec: str = Field(default="libx264", pattern=r"^[A-Za-z0-9_.-]+$")
    audio_codec: str = Field(default="aac", pattern=r"^[A-Za-z0-9_.-]+$")
    audio_bitrate: str = Field(default="128k", pattern=r"^[0-9]+[kKmM]$")
    threads: int = Field(default=1, ge=1, le=4)
    timeout_seconds: int = Field(default=900, ge=1, le=7200)
    ffprobe_timeout_seconds: int = Field(default=30, ge=1, le=300)
    minimum_free_bytes: int = Field(default=250_000_000, ge=1)
    sync_tolerance_seconds: float = Field(default=0.25, ge=0.01, le=2)
    caption_font_size: int = Field(default=26, ge=12, le=96)
    renderer_version: str = Field(default="m9-preview-v1", min_length=1, max_length=100)

    @model_validator(mode="after")
    def require_16_by_9(self) -> "RenderProfile":
        if abs(self.width / self.height - 16 / 9) > 0.02:
            raise ValueError("preview resolution must be 16:9")
        if self.video_codec not in SUPPORTED_VIDEO_ENCODERS:
            raise ValueError(f"unsupported video encoder: {self.video_codec}")
        if self.audio_codec not in SUPPORTED_AUDIO_ENCODERS:
            raise ValueError(f"unsupported audio encoder: {self.audio_codec}")
        return self



class PreviewRenderConfig(RenderProfile):
    """Bounded deterministic profile for the low-resolution review render."""


class FinalRenderConfig(RenderProfile):
    """Bounded deterministic profile for final source rendering."""

    width: int = Field(default=1920, ge=160, le=3840)
    height: int = Field(default=1080, ge=90, le=2160)
    audio_bitrate: str = "160k"
    renderer_version: str = "m10-final-v1"


class PublicationPreparationConfig(BaseModel):
    """Local M12 metadata and thumbnail policy, enforced before approval."""

    model_config = ConfigDict(extra="forbid")
    title_max_length: int = Field(default=100, ge=1, le=500)
    description_max_length: int = Field(default=5_000, ge=1, le=10_000)
    tag_max_count: int = Field(default=30, ge=1, le=100)
    tag_max_length: int = Field(default=100, ge=1, le=500)
    tag_payload_max_length: int = Field(default=500, ge=1, le=2_000)
    metadata_template_version: str = Field(default="m12-metadata-v1", min_length=1, max_length=100)
    thumbnail_template_version: str = Field(default="m12-thumbnail-v1", min_length=1, max_length=100)
    thumbnail_width: int = Field(default=1280, ge=160, le=3840)
    thumbnail_height: int = Field(default=720, ge=90, le=2160)
    thumbnail_max_bytes: int = Field(default=2_000_000, ge=1_024, le=10_000_000)

    @model_validator(mode="after")
    def require_16_by_9_thumbnail(self) -> "PublicationPreparationConfig":
        if abs(self.thumbnail_width / self.thumbnail_height - 16 / 9) > 0.02:
            raise ValueError("thumbnail resolution must be 16:9")
        return self


class YouTubePublishingConfig(BaseModel):
    """Explicitly opt-in, secret-free configuration for M13 publication."""
    model_config = ConfigDict(extra="forbid")
    enabled: bool = False
    dry_run: bool = True
    provider: str = Field(default="youtube", pattern=r"^youtube$")
    client_secret_path: Path | None = None
    token_storage_path: Path | None = None
    expected_channel_id: str | None = Field(default=None, min_length=1, max_length=200)
    privacy: str = Field(default="private", pattern=r"^(private|unlisted|public)$")
    chunk_size_bytes: int = Field(default=8_388_608, ge=262_144, le=64_000_000)
    implementation_version: str = Field(default="m13-youtube-v1", min_length=1, max_length=100)

    @model_validator(mode="after")
    def require_external_paths_when_enabled(self) -> "YouTubePublishingConfig":
        if self.enabled and (self.client_secret_path is None or self.token_storage_path is None or self.expected_channel_id is None):
            raise ValueError("enabled YouTube publishing requires client_secret_path, token_storage_path, and expected_channel_id")
        return self

class PublicationVerificationConfig(BaseModel):
    """Bounded, passive M14 processing verification policy."""
    model_config = ConfigDict(extra="forbid")
    enabled: bool = True
    pending_poll_seconds: int = Field(default=300, ge=30, le=86_400)
    maximum_processing_wait_seconds: int = Field(default=86_400, ge=300, le=604_800)

class AnalyticsConfig(BaseModel):
    """Bounded post-publication, read-only collection policy."""
    model_config = ConfigDict(extra="forbid")
    enabled: bool = True
    initial_delay_hours: int = Field(default=24, ge=0, le=720)
    collection_interval_hours: int = Field(default=24, ge=1, le=720)
    collection_horizon_days: int = Field(default=30, ge=1, le=3650)
    query_version: str = Field(default="m15-v1", min_length=1, max_length=100)

class PerformanceConfig(BaseModel):
    """Deterministic M16 evaluation thresholds."""
    model_config = ConfigDict(extra="forbid")
    evaluator_version: str = Field(default="m16-v1", min_length=1, max_length=100)
    proposal_version: str = Field(default="m16-proposal-v1", min_length=1, max_length=100)
    min_views_for_retention: int = Field(default=100, ge=0)
    min_impressions_for_ctr: int = Field(default=500, ge=0)
    baseline_min_videos: int = Field(default=5, ge=1)

class OptimizationCandidateConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")
    enabled: bool = True
    max_title_candidates: int = Field(default=3, ge=1, le=3)
    max_thumbnail_candidates: int = Field(default=2, ge=1, le=3)
    template_version: str = Field(default="m17-v1", min_length=1, max_length=100)

class OptimizationExecutionConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")
    enabled: bool = False
    dry_run: bool = True
    executor_version: str = Field(default="m18-v1", min_length=1, max_length=100)

class OptimizationExperimentConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")
    minimum_observation_hours: int = Field(default=24, ge=1, le=8760)
    evaluation_window_days: int = Field(default=7, ge=1, le=365)

class OptimizationConfig(BaseModel):
    model_config = ConfigDict(extra="forbid")
    candidates: OptimizationCandidateConfig = Field(default_factory=OptimizationCandidateConfig)
    execution: OptimizationExecutionConfig = Field(default_factory=OptimizationExecutionConfig)
    experiment: OptimizationExperimentConfig = Field(default_factory=OptimizationExperimentConfig)

class LearningConfig(BaseModel):
    """Deterministic M20--M23 post-experiment learning policy."""
    model_config = ConfigDict(extra="forbid")
    evaluator_version: str = Field(default="m20-v1", min_length=1, max_length=100)
    recommendation_version: str = Field(default="m22-v1", min_length=1, max_length=100)
    brief_template_version: str = Field(default="m23-v1", min_length=1, max_length=100)
    minimum_post_hours: int = Field(default=24, ge=1, le=8760)
    minimum_views: int = Field(default=100, ge=0)
    minimum_history_videos: int = Field(default=3, ge=1, le=1000)
    max_active_recommendations: int = Field(default=5, ge=1, le=20)

class PipelineConfig(BaseModel):
    """Safe provider selection and deterministic M7 voice settings."""

    model_config = ConfigDict(extra="forbid")

    # ``provider`` is retained only to read older configuration files. New
    # deployments select the independent content and voice adapters below.
    provider: str | None = Field(default=None, pattern=r"^(fake|codex|piper)$")
    content_provider: str = Field(default="fake", pattern=r"^(fake|codex)$")
    voice_provider: str = Field(default="fake", pattern=r"^(fake|piper)$")
    fake: FakeProviderConfig = Field(default_factory=FakeProviderConfig)
    codex: CodexProviderConfig = Field(default_factory=CodexProviderConfig)
    piper: PiperProviderConfig = Field(default_factory=PiperProviderConfig)
    voice: VoicePipelineConfig = Field(default_factory=VoicePipelineConfig)
    preview: PreviewRenderConfig = Field(default_factory=PreviewRenderConfig)
    final: FinalRenderConfig = Field(default_factory=FinalRenderConfig)
    publication: PublicationPreparationConfig = Field(default_factory=PublicationPreparationConfig)
    youtube: YouTubePublishingConfig = Field(default_factory=YouTubePublishingConfig)
    verification: PublicationVerificationConfig = Field(default_factory=PublicationVerificationConfig)
    analytics: AnalyticsConfig = Field(default_factory=AnalyticsConfig)
    performance: PerformanceConfig = Field(default_factory=PerformanceConfig)
    optimization: OptimizationConfig = Field(default_factory=OptimizationConfig)
    learning: LearningConfig = Field(default_factory=LearningConfig)
    media: MediaPipelineConfig = Field(default_factory=MediaPipelineConfig)
    sources: SourceIngestionConfig = Field(default_factory=SourceIngestionConfig)

    @model_validator(mode="after")
    def normalize_legacy_provider(self) -> "PipelineConfig":
        """Map legacy one-provider settings without blocking Codex plus Piper."""
        if self.provider is None:
            return self
        if self.provider == "fake":
            if self.content_provider != "fake" or self.voice_provider != "fake":
                raise ValueError("legacy pipeline.provider=fake conflicts with explicit provider selection")
            return self
        expected_content = "codex" if self.provider == "codex" else "fake"
        expected_voice = "piper" if self.provider == "piper" else "fake"
        if self.content_provider != "fake" or self.voice_provider != "fake":
            if (self.content_provider, self.voice_provider) != (expected_content, expected_voice):
                raise ValueError("legacy pipeline.provider conflicts with explicit provider selection")
        else:
            self.content_provider = expected_content
            self.voice_provider = expected_voice
        return self

from __future__ import annotations

import json
from datetime import UTC, datetime, timedelta
from pathlib import Path

import pytest

from tubeforge.core.config import CodexProviderConfig, DatabaseConfig, Settings
from tubeforge.core.errors import ProviderAuthenticationError, ProviderValidationError, RetryableProviderError
from tubeforge.db.models import Base
from tubeforge.db.repositories import CachedGeneration, GenerationCacheRepository
from tubeforge.db.session import create_database
from tubeforge.domain.contracts import ContentRequest, SourceReference
from tubeforge.providers.content.codex_cli import CodexCliContentProvider, ProcessResult, _safe_diagnostic
from tubeforge.providers.content.factory import create_content_provider
from tubeforge.providers.content.prompts import build_content_prompt
from tubeforge.providers.fake import FakeContentProvider


def request(*, topic: str = "Rain", prompt_version: str = "test-v1") -> ContentRequest:
    return ContentRequest(topic=topic, angle="A short explainer", target_duration_seconds=60, language="en-IN", audience="general", prompt_version=prompt_version, sources=(SourceReference(source_id="source-1", url="https://example.invalid/rain", title="Rain reference"),))


def package(value: ContentRequest) -> dict[str, object]:
    return {"schema_version": "1.0", "request": value.model_dump(mode="json"), "claims": [{"claim_id": "claim-1", "text": "Rain falls from clouds.", "source_ids": ["source-1"], "confidence": "high", "review_status": "verified", "human_review_required": False}], "script_sections": [{"section_id": "section-1", "narration": "Rain falls from clouds.", "scene_id": "scene-1", "claim_ids": ["claim-1"], "contains_factual_claims": True}], "scene_plans": [{"scene_id": "scene-1", "visual_type": "illustration", "search_queries": ["rain clouds"], "fallback_visual": "text_card"}], "metadata": {"title_options": ["Rain"], "description": "A cited explanation."}, "thumbnail_brief": {"text_options": ["RAIN"], "visual_direction": "Blue rain clouds", "accessibility_description": "Rain clouds"}, "clip_candidates": []}


@pytest.fixture
def resources(tmp_path: Path):
    database = create_database(DatabaseConfig(url=f"sqlite:///{tmp_path / 'cache.db'}"))
    Base.metadata.create_all(database.engine)
    try:
        yield GenerationCacheRepository(database.session_factory)
    finally:
        database.dispose()


def runner_with(payloads: list[object], calls: list[list[str]]):
    def runner(args: list[str], prompt: str, output: Path, timeout: int, limit: int) -> ProcessResult:
        calls.append(args)
        assert "REQUEST=" in prompt or "REPAIR=" in prompt
        output.write_text(json.dumps(payloads.pop(0)), encoding="utf-8")
        return ProcessResult(0, b'{"usage":{"input_tokens":12,"output_tokens":34}}\n', b"")
    return runner


def test_generation_persists_validated_package_provenance_usage_and_hits_cache(resources) -> None:
    calls: list[list[str]] = []
    value = request()
    provider = CodexCliContentProvider(CodexProviderConfig(), resources, process_runner=runner_with([package(value)], calls))
    assert provider.generate_package(value).claims[0].claim_id == "claim-1"
    assert provider.last_usage == {"input_tokens": 12, "output_tokens": 34}
    assert provider.last_provenance and provider.last_provenance["provider"] == "codex-cli"
    assert provider.generate_package(value).metadata.title_options == ("Rain",)
    assert len(calls) == 1


def test_cli_arguments_are_fixed_and_never_include_request_data(resources, tmp_path: Path) -> None:
    provider = CodexCliContentProvider(CodexProviderConfig(executable="fake-codex", model="model-a"), resources)
    args = provider.build_cli_args(tmp_path / "schema.json", tmp_path / "result.json")
    assert args[:7] == ["fake-codex", "exec", "--ephemeral", "--sandbox", "read-only", "--model", "model-a"]
    assert "Rain" not in args and "--json" in args


def test_cache_keys_normalize_but_change_for_meaningful_inputs(resources) -> None:
    value = request(topic="  Rain\r\n")
    normalized = request(topic="Rain")
    key = resources.cache_key(value, "codex-cli", "model-a", "v1")
    assert key == resources.cache_key(normalized, "codex-cli", "model-a", "v1")
    assert key != resources.cache_key(normalized, "codex-cli", "model-b", "v1")
    assert key != resources.cache_key(normalized, "other", "model-a", "v1")
    assert key != resources.cache_key(normalized, "codex-cli", "model-a", "v2")
    assert key != resources.cache_key(request(topic="Snow"), "codex-cli", "model-a", "v1")


def test_competing_reservation_blocks_and_expired_reservation_recovers(resources) -> None:
    now = datetime(2026, 8, 3, tzinfo=UTC)
    first = resources.reserve_or_get(request(), "codex-cli", "model", "v", now=now, reservation_seconds=10)
    assert first is not None
    assert resources.reserve_or_get(request(), "codex-cli", "model", "v", now=now, reservation_seconds=10) is None
    replacement = resources.reserve_or_get(request(), "codex-cli", "model", "v", now=now + timedelta(seconds=11), reservation_seconds=10)
    assert replacement is not None and replacement != first
    assert resources.accept(first, package(request()), {}, {}, now=now) is False
    assert resources.accept(replacement, package(request()), {"provider": "codex-cli"}, {}, now=now)
    cached = resources.reserve_or_get(request(), "codex-cli", "model", "v", now=now, reservation_seconds=10)
    assert isinstance(cached, CachedGeneration)


@pytest.mark.parametrize(("code", "stderr", "error"), [(1, b"login required token=abc", ProviderAuthenticationError), (124, b"timeout", RetryableProviderError), (1, b"network connection reset", RetryableProviderError)])
def test_process_failure_classification(resources, code: int, stderr: bytes, error: type[Exception]) -> None:
    def failed(*_): return ProcessResult(code, b"", stderr)
    with pytest.raises(error):
        CodexCliContentProvider(CodexProviderConfig(), resources, process_runner=failed).generate_package(request())


def test_invalid_json_and_schema_invalid_output_are_validation_failures(resources) -> None:
    def invalid_json(_a, _p, output, _t, _l):
        output.write_text("not-json", encoding="utf-8"); return ProcessResult(0, b"", b"")
    with pytest.raises(ProviderValidationError, match="valid JSON"):
        CodexCliContentProvider(CodexProviderConfig(), resources, process_runner=invalid_json).generate_package(request())


def test_targeted_repair_replaces_only_invalid_claim(resources) -> None:
    value = request(); invalid = package(value); invalid["claims"][0]["human_review_required"] = "wrong"  # type: ignore[index]
    repaired_claim = package(value)["claims"][0]  # type: ignore[index]
    calls: list[list[str]] = []
    provider = CodexCliContentProvider(CodexProviderConfig(repair_attempt_limit=1), resources, process_runner=runner_with([invalid, repaired_claim], calls))
    assert provider.generate_package(value).claims[0].human_review_required is False
    assert len(calls) == 2


def test_repair_exhaustion_never_accepts_cache(resources) -> None:
    value = request(); invalid = package(value); invalid["claims"][0]["human_review_required"] = "wrong"  # type: ignore[index]
    calls: list[list[str]] = []
    with pytest.raises(ProviderValidationError):
        CodexCliContentProvider(CodexProviderConfig(repair_attempt_limit=1), resources, process_runner=runner_with([invalid, invalid["claims"][0]], calls)).generate_package(value)  # type: ignore[index]
    assert resources.reserve_or_get(value, "codex-cli", "gpt-5.2-codex", value.prompt_version, now=datetime.now(UTC), reservation_seconds=1) is None


def test_prompt_is_versioned_and_source_bounded() -> None:
    text = build_content_prompt(request(), template_version="m6-content-v1", max_chars=10_000)
    assert "REQUEST=" in text and "untrusted data" in text
    with pytest.raises(ValueError, match="unsupported"):
        build_content_prompt(request(), template_version="old", max_chars=10_000)


def test_safe_diagnostic_redacts_and_truncates() -> None:
    value = _safe_diagnostic(b"authorization=top-secret\nnext", 20)
    assert "top-secret" not in value and len(value) <= 20


def test_fake_remains_default_provider(resources) -> None:
    settings = Settings.model_validate({"app": {"name": "x", "environment": "test"}, "database": {"url": "sqlite:///./x.db"}})
    assert isinstance(create_content_provider(settings, resources._session_factory), FakeContentProvider)  # noqa: SLF001
"""One offline, migrated-database walk from a job through the M23 brief."""

from __future__ import annotations

import hashlib
import json
import wave
from argparse import Namespace
from datetime import UTC, datetime, timedelta
from pathlib import Path

from alembic import command
from alembic.config import Config

from tubeforge.core.config import AnalyticsConfig, DatabaseConfig, FakeProviderConfig, LearningConfig, OptimizationConfig, PerformanceConfig, PreviewRenderConfig, VoicePipelineConfig, YouTubePublishingConfig
from tubeforge.db.repositories import AnalyticsRepository, ApprovalRepository, ArtifactRepository, JobRepository, LearningRepository, OptimizationRepository, PublicationRepository
from tubeforge.db.session import create_database
from tubeforge.domain.contracts import ContentRequest, SourceReference
from tubeforge.domain.states import ApprovalGate, JobState
from tubeforge.pipeline.learning import ChannelLearningService, ExperimentEvaluationService
from tubeforge.pipeline.optimization import OptimizationCandidateService, OptimizationExecutor, approval_identity
from tubeforge.pipeline.orchestrator import PipelineOrchestrator
from tubeforge.pipeline.performance import AnalyticsIngestionService, PerformanceService
from tubeforge.providers.fake import FakeContentProvider, FakeMediaProvider, FakePublisher, FakeVoiceProvider, FakeYouTubePublisher
from tubeforge.rendering.preview import checksum


class _Probe:
    def inspect(self, path: Path) -> dict[str, object]:
        with wave.open(str(path), "rb") as stream:
            return {"duration_seconds": stream.getnframes() / stream.getframerate(), "streams": []}


class _Assembler:
    def assemble(self, inputs: tuple[Path, ...], output: Path, *, pause_seconds: float = 0.0) -> None:
        with wave.open(str(inputs[0]), "rb") as source:
            parameters = source.getparams()
        output.parent.mkdir(parents=True, exist_ok=True)
        with wave.open(str(output), "wb") as target:
            target.setparams(parameters)
            for path in inputs:
                with wave.open(str(path), "rb") as source:
                    target.writeframes(source.readframes(source.getnframes()))


class _Renderer:
    """Portable rendering boundary used only because this host has no FFmpeg."""

    def __init__(self) -> None:
        self.config = PreviewRenderConfig(minimum_free_bytes=1)
        self.template_version = "integration-fake-renderer-v1"

    def identity(self, segments, narration, captions, *, approval_identity=None) -> str:
        return hashlib.sha256(f"{approval_identity}|{narration}|{captions}".encode()).hexdigest()

    def validate(self, path: Path, expected: float) -> dict[str, object]:
        assert path.is_file() and path.stat().st_size
        return {"duration_seconds": expected, "width": self.config.width, "height": self.config.height, "fps": self.config.fps, "video_codec": "h264", "audio_codec": "aac"}

    def render(self, segments, narration, captions, output: Path, *, cancellation_requested=None) -> dict[str, object]:
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_bytes(b"offline-rendered-video")
        return {"command": ["offline-renderer", str(output)], "metadata": self.validate(output, segments[-1].end_seconds), "checksum_sha256": checksum(output)}


def _migrate(database_path: Path) -> None:
    root = Path(__file__).resolve().parents[1]
    config = Config(str(root / "alembic.ini"))
    config.set_main_option("script_location", str(root / "migrations"))
    config.cmd_opts = Namespace(x=[f"database_url=sqlite:///{database_path}"])
    command.upgrade(config, "head")


def _request() -> ContentRequest:
    return ContentRequest(topic="Rain", angle="A 30-second offline explainer", target_duration_seconds=30, language="en-IN", audience="general", prompt_version="integration-v1", sources=(SourceReference(source_id="rain-source", url="https://example.invalid/rain", title="Rain"),))


def _metrics(views: int) -> dict[str, dict[str, object]]:
    available = lambda value: {"value": value, "availability": "available"}
    return {"views": available(views), "estimatedMinutesWatched": available(views), "averageViewDuration": available(30), "averageViewPercentage": available(60), "impressions": available(2_000), "impressionsClickThroughRate": available(2.0), "likes": available(max(1, views // 10)), "comments": available(1), "subscribersGained": available(1), "subscribersLost": available(0)}


def test_migrated_offline_job_reaches_m23_brief_and_resumes(tmp_path: Path) -> None:
    database_path = tmp_path / "integration.db"
    _migrate(database_path)
    database = create_database(DatabaseConfig(url=f"sqlite:///{database_path}"))
    try:
        settings = FakeProviderConfig(artifact_root=tmp_path / "providers")
        jobs, artifacts, approvals = JobRepository(database.session_factory), ArtifactRepository(database.session_factory), ApprovalRepository(database.session_factory)
        runner = PipelineOrchestrator(jobs, artifacts, approvals, FakeContentProvider(), FakeMediaProvider(settings), FakeVoiceProvider(settings), FakePublisher(), tmp_path / "artifacts", voice_config=VoicePipelineConfig(), audio_assembler=_Assembler(), ffprobe=_Probe(), preview_renderer=_Renderer(), final_renderer=_Renderer())
        job_id = "offline-e2e"
        jobs.create(job_id, _request())
        assert runner.run(job_id).state is JobState.SCRIPT_APPROVAL_REQUIRED
        approvals.record("script", job_id, ApprovalGate.SCRIPT, actor="integration")
        assert runner.run(job_id).state is JobState.PREVIEW_READY
        preview = runner._required_json(job_id, JobState.PREVIEW_RENDERING, "preview_manifest")
        approvals.record("preview", job_id, ApprovalGate.PREVIEW, reviewed_identity=preview["render_identity"], actor="integration")
        assert runner.run(job_id).state is JobState.FINAL_READY
        assert runner.run(job_id).state is JobState.PUBLICATION_APPROVAL_REQUIRED
        package = runner._required_json(job_id, JobState.PUBLICATION_PREPARING, "publication_package")
        thumbnail = runner._required_artifact(job_id, JobState.PUBLICATION_PREPARING, "thumbnail")
        assert Path(thumbnail.path).is_file() and Path(thumbnail.path).stat().st_size > 0
        approvals.record("publication", job_id, ApprovalGate.PUBLICATION_PREPARATION, reviewed_identity=package["publication_identity"], actor="integration")
        assert runner.run(job_id).state is JobState.PUBLICATION_READY

        # M13's real orchestration remains dry-run: it must make no provider mutation.
        youtube = FakeYouTubePublisher()
        runner.publisher = youtube
        runner.youtube_config = YouTubePublishingConfig(enabled=True, dry_run=True, client_secret_path=tmp_path / "client.json", token_storage_path=tmp_path / "token.json", expected_channel_id="fake-channel")
        publication_id = hashlib.sha256(b"offline-publication").hexdigest()
        approvals.record("publish", job_id, ApprovalGate.PUBLISH, reviewed_identity=publication_id, actor="integration")
        assert runner.run(job_id).state is JobState.PUBLICATION_READY
        assert youtube.create_calls == youtube.metadata_calls == youtube.thumbnail_calls == 0

        # Continue the post-publication loop through real repositories and services.
        publications = PublicationRepository(database.session_factory)
        publications.ensure(job_id, publication_id, str(package["publication_identity"]), "fake-channel", {"integration": True})
        publications.update(publication_id, state="healthy", remote_video_id="offline-video", created_at=datetime.now(UTC) - timedelta(days=4))
        youtube.videos["offline-video"] = {"privacy": "private", "title": str(package["metadata"]["title"]), "description": str(package["metadata"]["description"]), "tags": tuple(package["metadata"]["tags"]), "analytics": _metrics(500)}
        health, _, _ = runner._publication_health(package, datetime.now(UTC), youtube.fetch_publication_snapshot("offline-video"))
        assert health == "healthy"

        analytics, optimization, learning = AnalyticsRepository(database.session_factory), OptimizationRepository(database.session_factory), LearningRepository(database.session_factory)
        baseline = AnalyticsIngestionService(publications, analytics, youtube, AnalyticsConfig(initial_delay_hours=0)).collect(publication_id)
        assert baseline is not None and baseline.views == 500
        evaluation = PerformanceService(publications, analytics, PerformanceConfig(min_views_for_retention=1, min_impressions_for_ctr=1)).evaluate(publication_id)
        assert evaluation is not None
        proposal = analytics.proposal(hashlib.sha256(json.dumps({"evaluation": evaluation.evaluation_identity, "action": "TITLE_AND_THUMBNAIL", "version": "m16-proposal-v1"}, sort_keys=True, separators=(",", ":")).encode()).hexdigest())
        assert proposal is not None
        candidate = OptimizationCandidateService(publications, analytics, optimization, OptimizationConfig(), runner.publication_config, tmp_path.parents[1] / "o").generate(proposal.proposal_identity, current_title=str(package["metadata"]["title"]))[0]
        optimization.select(candidate.candidate_identity)
        binding = approval_identity(publication=publication_id, candidate=candidate.candidate_identity, proposal=proposal.proposal_identity, evaluation=evaluation.evaluation_identity, remote_video="offline-video", expected_title=str(package["metadata"]["title"]), executor_version="m18-v1")
        approvals.record("optimization", job_id, ApprovalGate.OPTIMIZATION, reviewed_identity=binding, actor="integration")
        assert OptimizationExecutor(publications, analytics, optimization, approvals, youtube, OptimizationConfig()).execute(candidate.candidate_identity).state == "DRY_RUN"
        applied = OptimizationExecutor(publications, analytics, optimization, approvals, youtube, OptimizationConfig.model_validate({"execution": {"enabled": True, "dry_run": False}})).execute(candidate.candidate_identity)
        assert applied is not None and applied.state == "APPLIED" and youtube.create_calls == 0

        youtube.videos["offline-video"]["analytics"] = _metrics(1_500)
        assert AnalyticsIngestionService(publications, analytics, youtube, AnalyticsConfig(initial_delay_hours=0)).collect(publication_id, now=datetime.now(UTC) + timedelta(days=1)) is not None
        outcome = ExperimentEvaluationService(analytics, optimization, publications, learning, LearningConfig(minimum_post_hours=1, minimum_views=1)).evaluate(applied.execution_identity, now=datetime.now(UTC) + timedelta(days=2))
        assert outcome is not None
        channel = ChannelLearningService(analytics, learning, LearningConfig(minimum_history_videos=1))
        assert channel.recommend("fake-channel")
        brief = channel.brief("fake-channel")
        assert json.loads(brief.recommendation_identities_json) and jobs.get(job_id).state is JobState.PUBLICATION_READY

        # Fresh objects against the same DB/artifact root prove durable checkpoints resume.
        restarted = PipelineOrchestrator(JobRepository(database.session_factory), ArtifactRepository(database.session_factory), ApprovalRepository(database.session_factory), FakeContentProvider(), FakeMediaProvider(settings), FakeVoiceProvider(settings), FakePublisher(), tmp_path / "artifacts", voice_config=VoicePipelineConfig(), audio_assembler=_Assembler(), ffprobe=_Probe(), preview_renderer=_Renderer(), final_renderer=_Renderer())
        assert restarted.run(job_id).state is JobState.PUBLICATION_READY
    finally:
        database.dispose()

codex
The repository already has the core resumable multi-scene renderer and a safe Codex CLI adapter; the main gap is that its deterministic provider emits only one scene, so the real pipeline cannot satisfy M24/M25. I’m implementing a six-scene fixed provider and deterministic scene-specific visuals without disturbing the one-scene fake fixtures used by older tests.
