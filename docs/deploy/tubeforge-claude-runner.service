# User-level unit (no root needed):
#   install -m 0644 docs/deploy/tubeforge-claude-runner.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tubeforge-claude-runner
[Unit]
Description=TubeForge Claude script runner (user-level)

[Service]
# Runs from the dev worktree; the venv lives in the main checkout (git-ignored, not in worktrees).
WorkingDirectory=%h/docker/tubeforge/tubeforge-dev
Environment=TUBEFORGE_PYTHON=%h/docker/tubeforge/Youtube_Video_Producer/.venv-benchmark/bin/python
ExecStart=%h/docker/tubeforge/tubeforge-dev/scripts/run_claude_runner.sh
# Spending limits (rolling 24 h; each defaults to the value shown, and an invalid or zero value falls
# back to the default, so the runner can never be unlimited by accident). A refused call burns no
# script attempt and the job retries later. Ledger: data/run/claude/usage-ledger.jsonl.
#Environment=TUBEFORGE_CLAUDE_MAX_CALLS_PER_DAY=40
#Environment=TUBEFORGE_CLAUDE_MAX_USD_PER_DAY=8.00
#Environment=TUBEFORGE_CLAUDE_MAX_USD_PER_CALL=1.50
Restart=on-failure

[Install]
WantedBy=default.target
