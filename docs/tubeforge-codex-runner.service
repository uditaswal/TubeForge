[Unit]
Description=TubeForge restricted host Codex runner
Requires=tubeforge-codex-runner.socket

[Service]
User=tubeforge-codex
Group=tubeforge-codex
ExecStart=/opt/tubeforge-codex-runner/venv/bin/python -m tubeforge.host_codex_runner
Environment=CODEX_HOME=/var/lib/tubeforge-codex/.codex
UMask=0077
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=no
PrivateDevices=yes
ReadWritePaths=/var/lib/tubeforge-codex
ReadOnlyPaths=/opt/tubeforge-codex-runner/codex-runtime
