# User-level unit (no root needed):
#   install -m 0644 docs/tubeforge-claude-runner.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now tubeforge-claude-runner
[Unit]
Description=TubeForge Claude script runner (user-level)

[Service]
WorkingDirectory=%h/docker/tubeforge/Youtube_Video_Producer
ExecStart=%h/docker/tubeforge/Youtube_Video_Producer/scripts/run_claude_runner.sh
Restart=on-failure

[Install]
WantedBy=default.target
